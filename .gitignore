# Secrets and environment
.env
.env.*
!.env.example
.envrc
.npmrc
.netrc
.pgpass
.git-credentials
*.pem
*.key

# Local AI tooling and IDE settings. Only .claude/CLAUDE.md is versioned. The directory itself must never
# be ignored (".claude/"): git cannot re-include a file below an excluded parent, so the negation would
# be silently dead. The negation must also come after the wildcard (last matching pattern wins).
.claude/*
!.claude/CLAUDE.md
CLAUDE.local.md
.cursor/
.aider*
.idea/
.vscode/
.DS_Store

# Local-only data, imports, exports and dumps (never commit real data)
/local/
*.sql
*.dump
*.sql.gz
*.csv
*.xlsx

# Runtime artefacts
/storage/*.key
/storage/logs/
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/views/
/storage/app/
*.log

# Dependencies and build output
/vendor/
/node_modules/
/public/build/
/public/hot
/public/storage

# Planning: risky session artefacts (logs, debug output, conversation copies, migration notes)
/.planning/debug/
/.planning/logs/
/.planning/sessions/
/.planning/**/*.log
/.planning/migration-notes/
# GSD codebase map: regenerate once Kokpit code exists, and keep it untracked until it passes
# scripts/check-sensitive.sh (the current map describes the GSD framework, not Kokpit).
/.planning/codebase/

# Exports and local databases
*.xls
*.ods
*.sqlite
*.sqlite3
/exports/

# Credentials and signing material
auth.json
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*.p8
*.jks
credentials.json
service-account*.json
*.ovpn

# Infrastructure state (may hold secrets in plain text)
*.tfstate
*.tfstate.*

# Test, coverage and tool caches
/coverage/
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache
