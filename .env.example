# DDEV-ready template: "cp .env.example .env" is the only copy step.
# Every key below is read by a config file; tests/Feature/Repo/EnvExampleTest.php keeps it that way.

# Application
APP_NAME=Kokpit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://kokpit.ddev.site

APP_LOCALE=cs
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Debugbar (dev-only package, absent from production installs). Unset it follows APP_DEBUG; the test suite forces it off.
# DEBUGBAR_ENABLED=true

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (PostgreSQL service of the DDEV project)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db

# Redis (cache, session, queue)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
# CACHE_PREFIX=

QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# Horizon (queue worker). The dashboard lives at /horizon for the Admin only; the defaults fit DDEV and production.
# HORIZON_NAME=
# HORIZON_DOMAIN=
# HORIZON_PATH=horizon
# HORIZON_PREFIX=
# Caps the worker processes per container; DDEV uses 2.
# HORIZON_MAX_PROCESSES=3

# Mail (Mailpit of the DDEV project)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="kokpit@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# The standard AWS names belong to AWS services only (the SES mailer); the object storage never reads them.
# Setting MAIL_MAILER to ses sends mail through the Amazon SES API with these credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# The next key is optional, for when SES runs in a region other than AWS_DEFAULT_REGION.
# AWS_SES_REGION=

# Object storage (RustFS of the DDEV project; the key pair is its public development default)
# The S3_ names are deliberate: the storage is S3-compatible but not AWS, and the AWS_ names stay free for AWS services.
FILESYSTEM_DISK=s3
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_DEFAULT_REGION=us-east-1
S3_BUCKET=kokpit-dev
S3_USE_PATH_STYLE_ENDPOINT=true
S3_ENDPOINT=http://rustfs:9000
# DDEV only: the RustFS endpoint resolves inside DDEV, so the browser cannot upload to it and temporary uploads stay local.
# Production leaves this unset (the bucket is the default) and ProductionConfigGuard refuses any disk without the s3 driver (D-18).
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

# Kokpit
# 2FA switch for local development and tests only; production keeps true.
KOKPIT_REQUIRE_ADMIN_2FA=true
# Canary harness for the test suite only; never true elsewhere.
KOKPIT_CANARY_HARNESS=false
# only for kokpit:install --no-interaction; never keep it in .env
# KOKPIT_ADMIN_PASSWORD=
# Signing secret of the incoming webhook endpoint; the route itself arrives with the integrations phase.
# WEBHOOK_CLIENT_SECRET=

# Optional framework keys the config reads without a default; unused unless set.
# DB_URL=
# MYSQL_ATTR_SSL_CA=
# REDIS_URL=
# REDIS_USERNAME=
# REDIS_PASSWORD=
# SESSION_CONNECTION=
# SESSION_STORE=
# SESSION_SECURE_COOKIE=
# CACHE_STORAGE_DISK=
# MEMCACHED_PERSISTENT_ID=
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# DYNAMODB_ENDPOINT=
# S3_URL=
# MAIL_URL=
# MAIL_SCHEME=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_LOG_CHANNEL=
# POSTMARK_API_KEY=
# RESEND_API_KEY=
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=
# LOG_SLACK_WEBHOOK_URL=
# LOG_STDERR_FORMATTER=
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=

# Stripe secrets: environment only, never stored in the settings or the database (D-16).
# The secret key creates payment links; the signing secret verifies the webhook. Both are required to create a link.
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=
