{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "kokpit/kokpit",
    "type": "project",
    "description": "Kokpit: an open-source CRM/ERP for a freelancer or small company, from client to tracked time to invoice to payment.",
    "keywords": [
        "laravel",
        "filament",
        "crm",
        "erp",
        "invoicing"
    ],
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.5",
        "brick/math": "^1.0",
        "brick/money": "~0.15.2",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-tags-plugin": "^5.10",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.50",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "spatie/eloquent-sortable": "^5.0",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-settings": "^3.9",
        "spatie/laravel-tags": "^4.12",
        "spatie/laravel-webhook-client": "^3.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel-lang/common": "^6.8",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.3",
        "symfony/yaml": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "stan": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "check-licenses": "@composer licenses --locked --format=json | php scripts/check-licenses.php",
        "ci": [
            "@test",
            "@lint",
            "@stan",
            "@check-licenses"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
